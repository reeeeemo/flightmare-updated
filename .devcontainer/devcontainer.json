{
  "name": "Flightmare",
  "image": "flightmare",
  "workspaceFolder": "/workspace",
  "forwardPorts": [10253, 10254, 6006],
  "runArgs": [
    "--gpus=all",
    "--ipc=host",
    "--ulimit", "memlock=-1",
    "--ulimit", "stack=67108864"
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  }
}